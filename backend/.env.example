# Kamelya backend ortam örneği — kopyala: cp .env.example .env
# .env dosyası asla commit edilmez (.gitignore: .env*).

APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_ADI=kamelya
DB_KULLANICI=kamelya
DB_SIFRE=buraya_yerel_sifreyi_yaz

CORS_ORIGINS=http://127.0.0.1:8080
RATE_LIMIT=120

# Güvenlik (F5) — üretimde HTTPS zorunlu; gizli anahtar min 32 bayt, dosyaya yazılmaz.
FORCE_HTTPS=false
JWT_GIZLI_ANAHTAR=buraya_en_az_32_bayt_rastgele_anahtar_yaz

ADMIN_EPOSTA=admin@kamelya.local
# ADMIN_SIFRE dosyaya yazılmaz; yalnızca ortamda tanımlanır (min 12 karakter).

# GSC (F7.2) — gerçek değerler sunucu ortamında; placeholder ile API kapalı kalır.
GSC_SERVICE_ACCOUNT_JSON=/path/to/service-account.json
GSC_SITE_URL=https://kamelya.com/

# E-posta SMTP (F9.2) — kimlik bilgileri dosyaya yazılmaz, sunucu ortamında tanımlanır.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_KULLANICI=
SMTP_SIFRE=
SMTP_SIFRELEME=yok
SMTP_GONDEREN=info@kamelya.local
